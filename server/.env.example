# Empire of Safavids — переменные окружения сервера
# Скопируйте в server/.env: cp server/.env.example server/.env

PORT=3000

# PostgreSQL (см. docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=empire_of_safavids
DB_USER=safavid_user
DB_PASSWORD=safavid_pass

# Redis
REDIS_URL=redis://localhost:6379

# Секрет для JWT — обязательно смените в продакшене
JWT_SECRET=change-me-in-production

# CORS: адрес веб-клиента
CLIENT_ORIGIN=http://localhost:8080

# Уровень логирования winston: error | warn | info | debug
LOG_LEVEL=debug
