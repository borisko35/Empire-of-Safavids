{
  "name": "empire-of-sefevids-server",
  "version": "0.1.0",
  "description": "Game server for Empire of Safavids Action MMORPG",
  "main": "dist/server/src/index/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/src/index/index.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "migrate": "ts-node src/database/migrate.ts",
    "db:init": "node scripts/init-db.js",
    "db:start": "pg_ctl -D .pg/data -o \"-p 5432\" -l .pg/postgres.log start"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.0",
    "redis": "^4.6.7",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.4.5",
    "@types/pg": "^8.10.2",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "jest": "^29.6.2",
    "node-windows": "^1.0.0-beta.8",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "scripts": {
    "start": "node server.js"
  }

}
