# ============================================================
# Empire of Safavids — Environment Configuration
# ============================================================

# ── PostgreSQL ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=empire_of_safavids
DB_USER=safavid_user
DB_PASSWORD=your_db_password

# ── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Server ─────────────────────────────────────────────────
PORT=3000
CLIENT_ORIGIN=http://localhost:8080
API_URL=http://localhost:3000

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-string

# ── OAuth — Google ─────────────────────────────────────────
# Получить в Google Cloud Console: https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — Facebook ───────────────────────────────────────
# Получить в Meta for Developers: https://developers.facebook.com
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── OAuth — VK ─────────────────────────────────────────────
# Получить в VK Apps: https://vk.com/apps?act=manage
VK_CLIENT_ID=
VK_CLIENT_SECRET=
