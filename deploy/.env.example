# ============================================================
# Конфигурация боевого сервера — Empire of Safavids
# Скопируйте в deploy/.env и заполните свои значения:
#   cp deploy/.env.example deploy/.env
# ============================================================

# Домен игры. A-запись DNS должна указывать на IP вашего VPS,
# порты 80 и 443 открыты. Сертификаты Let's Encrypt выпустятся сами.
DOMAIN=game.example.com

# Пароль PostgreSQL — сгенерируйте свой:
#   openssl rand -hex 16
POSTGRES_PASSWORD=change-me-strong-password

# Секрет для подписи JWT-сессий — сгенерируйте свой:
#   openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-openssl-rand-hex-32

# Происхождение клиента для CORS (по умолчанию выводится из DOMAIN)
CLIENT_ORIGIN=https://game.example.com

# Необязательно: имя базы и пользователя
#DB_NAME=empire_of_safavids
#DB_USER=safavid_user

# ═══════════════════════════════════════════════════════════════
# Куда выкатывать — это главное, что было не так
# ═══════════════════════════════════════════════════════════════
#
# 8 октября 2026 выкатка отработала целиком, оба образа пересобрались,
# скрипт напечатал `RESULT: PASS` — а живой сайт отдавал СТАРУЮ сборку.
# Причина: скрипт собирал стек только на той машине, где запущен, а прод
# живёт на AWS. Имя туннеля Cloudflare одно и то же в обоих местах, то
# есть у туннеля два коннектора, и запросы обслуживал не тот, что
# пересобирали.
#
# Теперь в скрипте есть выбор цели, и он читается отсюда.
#
#   local — стек на этой машине (стенд)
#   aws   — боевой сервер
#
# ВНИМАНИЕ, aws. Группа безопасности AWS должна пускать порт 22 с адреса
# той машины, откуда идёт выкатка. Если адрес не тот, выкатка остановится
# ДО сборки и напечатает адрес, который надо открыть.
#
# ПОЧЕМУ НЕ УГАДЫВАТЬ ЦЕЛЬ. Молчаливый выбор цели и есть тот баг: скрипт
# проверял свой стек и называл это проверкой прода.
#
#EOS_DEPLOY_TARGET=local
#
# Настройки цели aws. Путь к ключу — от пользователя этой машины.
# На AWS код едет гитом и собирается ТАМ: собирать на t3.micro с 911 МБ
# памяти нельзя, там под это разбит своп.
#EOS_AWS_HOST=18.197.33.141
#EOS_AWS_USER=ubuntu
#EOS_AWS_KEY=$HOME/.ssh/eos-key.pem
#EOS_AWS_DIR=/home/ubuntu/empire-of-safevids

# ═══════════════════════════════════════════════════════════════
# Вход через Google и VK
# ═══════════════════════════════════════════════════════════════
# Кнопки «Войти через Google / ВКонтакте» ПОЯВЛЯЮТСЯ только когда
# заполнены и id, и секрет. Пока пусто — игрок видит гостевой вход
# и обычную форму, ничего не ломается.
#
# Как получить ключи:
#   Google — console.cloud.google.com -> «Создать проект» ->
#     «API и сервисы» -> «Учётные данные» -> «Создать OAuth client ID»
#     (тип «Web application») -> в «Разрешённые URI перенаправления»
#     указать: https://<ваш домен>/game/
#   Facebook — developers.facebook.com -> «Создать приложение» ->
#     «Продукты» -> «Вход через Facebook» -> тип «Веб-сайт» ->
#     «Допустимые домены OAuth»: <ваш домен> (без https:// и без пути),
#     «URI перенаправления OAuth»: https://<ваш домен>/game/
#
# ВНИМАНИЕ про Facebook. В отличие от Google, для публичного входа
# посторонним игрокам требуется:
#   1) подтверждение бизнес-аккаунта разработчика (Business Verification);
#   2) отправка приложения на проверку (App Review) — она нужна, чтобы
#      вход работал у всех, а не только у разработчиков и тестовых
#      пользователей. Пока проверка не пройдена, кнопка работает только
#      у тех, кого добавят в «Testers».
#   Мы намеренно НЕ запрашиваем право email — оно требует проверки, а без
#   него игрок просто получит аккаунт со служебной почтой вместо настоящей.
#
# СЕКРЕТ НИКОГДА не попадает в браузер: код обменивается на токен
# на сервере, в браузер уходит только client_id.
#
#GOOGLE_CLIENT_ID = xxxxxxxxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET = xxxxxxxxx
#FACEBOOK_CLIENT_ID = 1234567890123456
#FACEBOOK_CLIENT_SECRET = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Платежи (ЮKassa) ────────────────────────────────────────────
# Пока эти три значения не 'true', кнопка покупки работает, но счёт
# не создаётся: игрок видит честное «приём платежей ещё не настроен».
# Денег за это не списывается, начислений нет.
#
# ЧТО НУЖНО ДЛЯ РЕГИСТРАЦИИ. Личный кабинет ЮKassa открывают только
# с ИП или ООО, зарегистрированным в России. Для физлица аккаунт
# не откроют — это правило провайдера, а не настройка игры. Пока такого
# документа нет, платежи остаются выключенными, и это нормально:
# наборы странника уже продаются за игровые AZENS в игровых магазинах.
#
# Где взять значения: личный кабинет ЮKassa -> «Настройки» -> «API ключи».
# Shop ID и секретный ключ — две разные строки, путать их нельзя.
#
# После заполнения перезапустить сервер. Ничего больше делать не нужно:
# адаптер, маршрут вебхука и возврат на сайт уже написаны.
#
#PAYMENT_JOBIK_ENABLED = false
#PAYMENT_JOBIK_SHOP_ID = xxxxxxxxx
#PAYMENT_JOBIK_SECRET = xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Xsolla ──────────────────────────────────────────────────────
# Провайдер выключен по умолчанию: без XSOLLA_ENABLED код игнорирует все
# остальные значения и отвечает «провайдер не настроен», а сайт работает
# как обычно.
#
# ПОЧЕМУ ЭТОТ БЛОК НУЖЕН, А ПРОСТОГО ЗНАЧЕНИЯ НЕ ХВАТАЕТ. Переменные
# перечислены поимённо в deploy/docker-compose.prod.yml, и пока
# переменной нет в том списке, значение из этого файла до контейнера
# просто не доходит. Такое уже случалось: .env был заполнен правильно, а
# сервер ключей не видел. Поэтому после заполнения обязательна
# пересборка, а не просто перезапуск.
#
# Где взять: Publisher ID и Project ID - из адреса кабинета
# (https://xsolla.com/for/web-games/account/<publisher>/projects/<project>).
# API-ключ и секрет вебхука - Project settings -> API keys и Webhooks.
#
# XSOLLA_SANDBOX=true переключает на тестовую витрину: платежи не трогают
# настоящих денег. До подписания договора не выключать.
#XSOLLA_ENABLED = false
#XSOLLA_PUBLISHER_ID = 000000
#XSOLLA_PROJECT_ID = 000000
#XSOLLA_API_KEY = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#XSOLLA_WEBHOOK_SECRET = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Секрет виджета ВХОДА (Xsolla Login). От платёжного XSOLLA_API_KEY не
# зависит: это разные разделы кабинета Xsolla. Без него вход через
# Xsolla не работает — обмен кода нечем подтвердить (см. §124 карты).
#XSOLLA_LOGIN_SECRET = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#XSOLLA_SANDBOX = true

# ── Intellect Money ────────────────────────────────────────────────
# Платёжный виджет Intellect Money. Работает через JS-виджет на клиенте:
# https://merchant.intellectmoney.ru/v2/js/IntellectMoneyMerchantWidget.js
# Сервер возвращает параметры инициализации виджета, клиент отрисовывает
# форму оплаты, а Intellect Money шлёт уведомление на ResultUrl.
#
# ПОЧЕМУ ВИДЖЕТ. Игрок не уходит на чужой домен — карта вводится в iframe
# виджета, SberPay/ApplePay/Google Pay работают нативно. Конверсия выше.
#
# ЧТО НУЖНО. Личный кабинет Intellect Money: https://intellectmoney.ru
# В настройках магазина задать ResultUrl = https://<ваш домен>/api/game/payments/webhook/intellectmoney
# (обратите внимание: протокол HTTPS обязателен для ResultUrl).
#
# ОПЕЧАТКА БЫЛА ЗДЕСЬ, И ОНА БЫЛА ДОРОГОЙ. Стояло `paywords` вместо
# `payments`. Тот, кто настраивал ResultUrl по этой строке, вписал в кабинет
# адрес, по которому уведомления о оплате приходят в CMS и пропадают: платёж
# проходит, а AZENS не начисляются. Путь проверяется тестом apiSurface.
#
# EshopId — ID магазина (число, видно в списке магазинов).
# SecretKey — секретный ключ магазина (задаётся в настройках магазина на вкладке «Подключение магазина»).
# SignSecretKey — секрет для заголовка Sign API (получается вместе с Bearer токеном на странице профиля безопасности).
#
# Все три значения должны быть заполнены. Без них провайдер не включается.
#
#PAYMENT_INTELLECTMONEY_ENABLED = false
#PAYMENT_INTELLECTMONEY_ESHOP_ID = 123456
#PAYMENT_INTELLECTMONEY_SECRET_KEY = your_secret_key_here
#PAYMENT_INTELLECTMONEY_SIGN_SECRET_KEY = your_sign_secret_key_here

# ── Симулятор платежей ──────────────────────────────────────────
# Только для проверки на своей машине. На боевом сервере ДОЛЖЕН быть
# false: при true любой вошедший игрок может напечатать себе AZENS
# без оплаты, потому что симулятор идёт тем же путём, что и вебхук.
PAYMENTS_SIMULATOR = false
