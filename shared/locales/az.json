  "history": {
    "title": "Səfəvi imperiyasının tarixi",
    "subtitle": "1501 — 1736 · İki yüz otuz beş illik əzəmət",
    "intro": "Gənc İsmayıldan — İranı iman və qılınclovla alovlandırandan, böyük Abbasadək — İsfahanı dünyanın yarısına çevirənə qədər Səfəvi imperiyası İpək Yolunun ürəyi, sənətin beşiyi və böyük dövlətlərin döyüş meydanı idi. Bu tarix — oyununuzun fonudur.",
    "back": "Menyuya qayıt",
    "timeline_label": "Xronologiya"
  },
  "history_events": [
    {
      "year": "1501",
      "title": "İmperiyanın doğuşu",
      "text": "Şah I İsmayıl Təbrizə daxil olaraq Səfəvi dövlətini elan edir. Şiəlik dövlət dininə çevrilir — İran yeni üz qazanır."
    },
    {
      "year": "1514",
      "title": "Çaldıran döyüşü",
      "text": "Osmanlı sultanı I Səlim Qanı İsmayıla ilk məğlubiyyəti verir. İmperiya ayaqda qalır, lakin Osmanlılarla əbədi rəqabət taleyini müəyyənləşdirir."
    },
    {
      "year": "1548",
      "title": "Paytaxt köçürülür",
      "text": "I Təhmasib sarayı müdafiəsi çətin Təbrizdən Qəzvinə köçürür. Sərhədlər qərbdə də, şərqdə də müharibə ilə nəbzdəyir."
    },
    {
      "year": "1587",
      "title": "Abbasın yüksəlişi",
      "text": "On altı yaşlı I Abbas Böyük taxta çıxır. O, yeni tip ordu — «şah alaylarını» yaradacaq və imperiyaya qüdrətini qaytaracaq."
    },
    {
      "year": "1598",
      "title": "İsfahan — dünyanın yarısı",
      "text": "Abbas paytaxtı İsfahana köçürür. İmam meydanı, firuzəyi günbəzlər və bazarlar şəhəri əfsanəyə çevirir: «İsfahan — dünyanın yarısıdır»."
    },
    {
      "year": "1603",
      "title": "Təbrizin qayıdışı",
      "text": "I Abbas Azərbaycanı və Təbrizi osmanlı ordularını məğlub edərək geri alır. İmperiya hərbi zirvəsinə çatır."
    },
    {
      "year": "1622",
      "title": "Ticarət yollarının ağası",
      "text": "Qəndəhar alınır, portuqallar Hörmüzdən qovulur. Fars ipəyi Avropaya axır; xəzinə Böyük İpək Yolunun qızılı ilə dolur."
    },
    {
      "year": "1722",
      "title": "İsfahanın süqutu",
      "text": "Mahmud Hotəkinin əfqan tayfaları uzun mühasirədən sonra paytaxtı alır. Qızıl dövr aclıq və yanğınlla bitir."
    },
    {
      "year": "1736",
      "title": "Səfəvilərin qürubu",
      "text": "Nadir şah İranın yeni hökmdarı kimi tac qoyur. Səfəvi sülaləsi tarixə qovuşur — amma onun sənəti əsrlər boyu yaşayır."
    }
  ],
